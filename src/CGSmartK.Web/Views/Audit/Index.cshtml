@{ViewData["Title"]="Audit";var s=ViewData["Status"] as OperationStatus;}<h1>Operation status</h1><form method="get"><label for="correlationId">Correlation ID</label><div class="input-group"><input class="form-control" id="correlationId" name="correlationId" required><button class="btn btn-primary">Look up</button></div></form>@if(s is not null){<dl class="row mt-4"><dt class="col-3">Operation</dt><dd class="col-9">@s.Operation</dd><dt class="col-3">State</dt><dd class="col-9">@s.State</dd><dt class="col-3">Items</dt><dd class="col-9">@s.ItemCount</dd><dt class="col-3">Updated</dt><dd class="col-9">@s.UpdatedAt.ToString("u")</dd></dl>}
