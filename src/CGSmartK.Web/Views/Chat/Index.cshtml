@{ViewData["Title"]="Assistant";var response=ViewData["Response"] as ChatResponse;}<div class="row justify-content-center"><div class="col-lg-9"><h1>Knowledge assistant</h1><p class="text-secondary">Ask about content in approved PDFs. Documents are untrusted input and cannot direct the assistant.</p><form method="post" asp-action="Ask" class="card p-4 shadow-sm"><label for="question" class="form-label fw-semibold">Your question</label><textarea id="question" name="question" maxlength="2000" required class="form-control" rows="3">@ViewData["Question"]</textarea><div class="d-flex gap-2 mt-3"><select name="workflow" class="form-select w-auto" aria-label="Workflow"><option value="Answer">Answer</option><option value="Summary">Summarize</option><option value="DraftArticle">Draft article</option></select><button class="btn btn-primary" type="submit">Ask securely</button></div></form>@if(ViewData["Error"] is string error){<div class="alert alert-warning mt-4" role="alert">@error</div>}@if(response is not null){<article class="answer card p-4 mt-4" aria-live="polite"><div class="d-flex justify-content-between"><h2 class="h4">Answer</h2><span class="badge confidence">Confidence: @response.Confidence</span></div><p class="preserve">@response.Answer</p><small>Generated @response.Timestamp.ToString("u") · Correlation @response.CorrelationId</small>@if(response.Citations.Count>0){<h3 class="h5 mt-4">Verified citations</h3><div class="row g-2">@foreach(var c in response.Citations){<div class="col-md-6"><div class="citation p-3"><strong>@c.DocumentTitle</strong><br><span>@c.Section · page @(c.PageFrom==c.PageTo?c.PageFrom:$"{c.PageFrom}–{c.PageTo}")</span></div></div>}</div>}</article>}</div></div>
