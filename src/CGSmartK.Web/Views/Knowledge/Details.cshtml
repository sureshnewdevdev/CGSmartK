@model KnowledgeDocument
@{ViewData["Title"]="Document";}<h1>@Model.Title</h1><dl class="row"><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Source file</dt><dd class="col-sm-9">@Model.OriginalFileName</dd><dt class="col-sm-3">Indexed chunks</dt><dd class="col-sm-9">@Model.IndexedChunkCount</dd><dt class="col-sm-3">Failure</dt><dd class="col-sm-9">@(Model.FailureReason??"None")</dd><dt class="col-sm-3">Content hash</dt><dd class="col-sm-9"><code>@Model.ContentHash</code></dd></dl><form method="post" asp-action="Reindex"><input type="hidden" name="id" value="@Model.Id"><button class="btn btn-secondary">Re-index</button></form><form method="post" asp-action="Delete" class="mt-3"><input type="hidden" name="id" value="@Model.Id"><label><input type="checkbox" name="confirm" value="true" required> I confirm permanent removal of the PDF and indexed chunks.</label><br><button class="btn btn-danger mt-2">Delete</button></form>
