@model IReadOnlyList<KnowledgeDocument>
@{ViewData["Title"]="Knowledge";}<div class="d-flex justify-content-between"><h1>Knowledge administration</h1><a class="btn btn-primary" asp-action="Upload">Upload PDF</a></div>@if(Model.Count==0){<div class="empty mt-4">No approved documents have been uploaded.</div>}else{<div class="table-responsive"><table class="table mt-4"><thead><tr><th>Title</th><th>Category</th><th>Classification</th><th>Status</th><th>Updated</th></tr></thead><tbody>@foreach(var d in Model){<tr><td><a asp-action="Details" asp-route-id="@d.Id">@d.Title</a></td><td>@d.Category</td><td>@d.Access.Classification</td><td>@d.Status</td><td>@d.UpdatedAt.ToString("u")</td></tr>}</tbody></table></div>}
