@{ViewData["Title"]="Upload";}<h1>Upload approved PDF</h1><p class="text-secondary">Need safe test data? <a href="~/samples/synthetic-employee-handbook.pdf" download>Download the 120-line synthetic employee handbook</a>.</p><form method="post" enctype="multipart/form-data" class="card p-4"><div asp-validation-summary="All" class="text-danger"></div><label class="form-label" for="file">PDF (maximum 20 MB)</label><input class="form-control" id="file" name="file" type="file" accept="application/pdf,.pdf" required><label class="form-label mt-3" for="title">Title</label><input class="form-control" id="title" name="title" maxlength="200" required><label class="form-label mt-3" for="category">Category</label><input class="form-control" id="category" name="category" maxlength="100" required><label class="form-label mt-3" for="classification">Classification</label><select class="form-select" id="classification" name="classification"><option>Internal</option><option>Public</option><option>Confidential</option></select><label class="form-label mt-3" for="allowedGroups">Allowed groups (comma separated, optional)</label><input class="form-control" id="allowedGroups" name="allowedGroups" maxlength="500"><button class="btn btn-primary mt-4" type="submit">Upload and queue ingestion</button></form>
